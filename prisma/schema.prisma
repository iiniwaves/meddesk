generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(DOCTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  NURSE
}

model Patient {
  id          String   @id @default(cuid())
  patientNo   String   @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String
  phone       String
  address     String?
  bloodGroup  String?
  allergies   String[]
  hmo         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}